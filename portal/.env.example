# Copy to .env.local (never committed). Never put secret/service-role keys in NEXT_PUBLIC variables.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# In production set this to the portal origin: https://portal.brightlb.com
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3000

# Server-only admin key, used only for employee administration (invites, roles). Never expose it.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
